{
  "name": "veritas-web",
  "version": "0.1.0",
  "private": true,
  "description": "Veritas DFIR examiner web application",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:api": "openapi-typescript lib/openapi.json -o lib/api-schema.d.ts --default-non-nullable false",
    "e2e": "playwright test",
    "lhci": "node scripts/lhci.ts",
    "screenshots": "node scripts/screenshots.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-virtual": "^3.14.26",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.68.0",
    "next": "^15.5.29",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
