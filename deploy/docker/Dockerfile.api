# syntax=docker/dockerfile:1.7
# Veritas API (FastAPI). Build from the repository root:
#   docker build -f deploy/docker/Dockerfile.api -t ghcr.io/lumidren/veritas-api:dev .
# Runs as uid 10001 and works with a read-only root filesystem: it writes only to
# /var/lib/veritas (data volume) and /tmp (emptyDir / tmpfs).

FROM python:3.12.16-slim-bookworm AS build
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential zlib1g-dev libffi-dev \
 && rm -rf /var/lib/apt/lists/*
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
WORKDIR /src
COPY python/ /src/python/
RUN pip install --upgrade pip==26.3 setuptools==84.2.1 wheel==0.48.0 \
 && pip install "/src/python[cluster]" opentelemetry-exporter-otlp-proto-http==1.27.0 opentelemetry-instrumentation-fastapi==0.48b0 \
 && python -m compileall -q /opt/venv/lib \
 && pip check

FROM python:3.12.16-slim-bookworm AS runtime
LABEL org.opencontainers.image.title="veritas-api" \
      org.opencontainers.image.source="https://github.com/lumidren/Digital-Forensics-Tool" \
      org.opencontainers.image.licenses="Apache-2.0"
# postgresql-client-16 (from the PGDG repository) provides pg_dump/pg_restore matching the Postgres 16
# server for scripts/backup; Debian bookworm ships only client 15.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# upgrade: pull Debian security fixes released after the base image was built (Trivy image gate).
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && apt-get install -y --no-install-recommends tini ca-certificates curl gnupg \
 && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /usr/share/keyrings/pgdg.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/pgdg.gpg] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client-16 \
 && apt-get purge -y --auto-remove curl gnupg \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 10001 veritas \
 && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin veritas \
 && install -d -o 10001 -g 10001 -m 0750 /var/lib/veritas
COPY --from=build /opt/venv /opt/venv
COPY --chown=10001:10001 scripts/backup/ /opt/veritas/scripts/backup/
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TMPDIR=/tmp \
    VERITAS_DATA_DIR=/var/lib/veritas
USER 10001:10001
WORKDIR /var/lib/veritas
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["python", "-c", "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=4).status == 200 else 1)"]
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["uvicorn", "veritas.api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*", "--no-server-header", "--no-access-log"]
