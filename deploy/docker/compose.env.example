# Copy to deploy/docker/.env and set every value. Never commit the filled-in file.
# Generate secrets with:  python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_USER=veritas-root
MINIO_ROOT_PASSWORD=
MINIO_APP_SECRET=
# 32 bytes as 64 hex characters; escrow it as described in docs/DR.md before ingesting evidence.
VERITAS_MASTER_KEY=
EVIDENCE_RETENTION_DAYS=3650
# Password for the sample users created by scripts/bootstrap/sample_case.py (min 12 characters);
# when empty the script generates one per user and writes them to <out>/credentials.json (mode 0600).
VERITAS_BOOTSTRAP_PASSWORD=
