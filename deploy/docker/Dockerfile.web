# syntax=docker/dockerfile:1.7
# Veritas web UI (Next.js 15). Requires `output: "standalone"` in web/next.config.*.
#   docker build -f deploy/docker/Dockerfile.web --build-arg NEXT_PUBLIC_API_BASE=/api -t ghcr.io/lumidren/veritas-web:dev .

FROM node:22.23.4-bookworm-slim AS deps
WORKDIR /app
COPY web/package.json web/package-lock.json ./
# The lockfile is written by npm 11; npm 10 (bundled with Node 22) resolves it differently.
RUN npm install -g npm@11.21.2 && npm ci --no-audit --no-fund

FROM node:22.23.4-bookworm-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production
ARG NEXT_PUBLIC_API_BASE=/api
ENV NEXT_PUBLIC_API_BASE=${NEXT_PUBLIC_API_BASE}
COPY --from=deps /app/node_modules ./node_modules
COPY web/ ./
RUN mkdir -p public \
 && npm run build \
 && test -f .next/standalone/server.js

FROM gcr.io/distroless/nodejs22-debian12:nonroot AS runtime
LABEL org.opencontainers.image.title="veritas-web" \
      org.opencontainers.image.source="https://github.com/lumidren/Digital-Forensics-Tool" \
      org.opencontainers.image.licenses="Apache-2.0"
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build --chown=10001:10001 /app/.next/standalone ./
COPY --from=build --chown=10001:10001 /app/.next/static ./.next/static
COPY --from=build --chown=10001:10001 /app/public ./public
USER 10001:10001
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["/nodejs/bin/node", "-e", "require('http').get('http://127.0.0.1:3000/', r => process.exit(r.statusCode < 500 ? 0 : 1)).on('error', () => process.exit(1))"]
CMD ["server.js"]
